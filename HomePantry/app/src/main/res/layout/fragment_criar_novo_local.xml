<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- TÍTULO -->
        <TextView
            android:id="@+id/txt_titulo_criar_local"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/titulo_criar_local"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />

        <!-- NOME DO LOCAL -->
        <EditText
            android:id="@+id/edt_nome_local"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_nome_local"
            android:inputType="textPersonName"
            android:layout_marginBottom="12dp" />

        <!-- DESCRIÇÃO DO LOCAL -->
        <EditText
            android:id="@+id/edt_descricao_local"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_descricao_local"
            android:inputType="textMultiLine"
            android:minLines="3"
            android:gravity="top"
            android:layout_marginBottom="16dp" />

        <!-- PREVIEW DA FOTO -->
        <ImageView
            android:id="@+id/img_foto_local"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:layout_marginBottom="12dp"
            android:scaleType="centerCrop"
            android:background="@android:color/darker_gray" />

        <!-- BOTÃO FOTO (OPCIONAL, SEM LÓGICA AINDA) -->
        <Button
            android:id="@+id/btn_carregar_foto_novo_local"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_carregar_foto_novo_local"
            android:layout_marginBottom="16dp" />

        <!-- BOTÃO CRIAR -->
        <Button
            android:id="@+id/btn_criar_local"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_criar_local" />

    </LinearLayout>
</ScrollView>
