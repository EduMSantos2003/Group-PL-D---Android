<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:card_view="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="10dp"
    card_view:cardCornerRadius="14dp"
    card_view:cardElevation="6dp"
    card_view:cardUseCompatPadding="true">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp">

        <!-- TEXTOS (lado esquerdo) -->
        <LinearLayout
            android:id="@+id/layoutTexto"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_alignParentStart="true"
            android:layout_toStartOf="@+id/layoutAcoes"
            android:layout_marginEnd="12dp">

            <TextView
                android:id="@+id/txtLocal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Local: -"
                android:textSize="14sp"
                android:textColor="@android:color/black" />

            <TextView
                android:id="@+id/txtValidade"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Validade: 2025-12-23"
                android:textSize="14sp"
                android:textColor="@android:color/black" />

            <TextView
                android:id="@+id/txtQtd"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Qtd: 20"
                android:textSize="14sp"
                android:textColor="@android:color/black" />
        </LinearLayout>

        <!-- AÇÕES (lado direito) -->
        <LinearLayout
            android:id="@+id/layoutAcoes"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_alignParentEnd="true"
            android:gravity="center_horizontal">

            <ImageButton
                android:id="@+id/btnVer"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@android:color/transparent"
                android:contentDescription="Ver"
                android:src="@android:drawable/ic_menu_view" />

            <ImageButton
                android:id="@+id/btnEditar"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@android:color/transparent"
                android:contentDescription="Editar"
                android:src="@android:drawable/ic_menu_edit" />

            <ImageButton
                android:id="@+id/btnApagar"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@android:color/transparent"
                android:contentDescription="Apagar"
                android:src="@android:drawable/ic_menu_delete" />
        </LinearLayout>

        <!-- BOTÕES EM BAIXO (setas) -->
        <LinearLayout
            android:id="@+id/layoutSetas"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/layoutTexto"
            android:layout_alignParentStart="true"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btnMenos"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@android:color/transparent"
                android:contentDescription="Menos"
                android:src="@android:drawable/ic_media_previous" />

            <ImageButton
                android:id="@+id/btnMais"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@android:color/transparent"
                android:contentDescription="Mais"
                android:src="@android:drawable/ic_media_next" />
        </LinearLayout>

    </RelativeLayout>

</androidx.cardview.widget.CardView>
