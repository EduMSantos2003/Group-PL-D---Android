<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/ListaProdutosFragment">

    <!-- DASHBOARD LOCAL -->
    <fragment
        android:id="@+id/dashboardLocalFragment"
        android:name="pt.ipleiria.estg.dei.amsi.homepantry.DashboardLocalFragment"
        android:label="Dashboard Local"
        tools:layout="@layout/fragment_dashboard_local">

        <argument
            android:name="localId"
            app:argType="integer" />

        <argument
            android:name="nomeLocal"
            app:argType="string" />
    </fragment>

    <!-- LISTA DE LOCAIS -->
    <fragment
        android:id="@+id/ListaLocaisFragment"
        android:name="pt.ipleiria.estg.dei.amsi.homepantry.ListaLocaisFragment"
        android:label="Lista Locais"
        tools:layout="@layout/fragment_lista_locais">

        <action
            android:id="@+id/action_listaLocais_to_dashboardLocal"
            app:destination="@id/dashboardLocalFragment" />

        <action
            android:id="@+id/action_listaLocais_to_criarNovoLocal"
            app:destination="@id/CriarNovoLocalFragment" />
    </fragment>

    <!-- LISTA DE PRODUTOS -->
    <fragment
        android:id="@+id/ListaProdutosFragment"
        android:name="pt.ipleiria.estg.dei.amsi.homepantry.ListaProdutosFragment"
        android:label="Produtos / Stock">

        <action
            android:id="@+id/action_listaProdutos_to_gerirProduto"
            app:destination="@id/gerirProdutoFragment" />

        <action
            android:id="@+id/action_listaProdutos_to_criarNovoProduto"
            app:destination="@id/CriarNovoProdutoFragment" />
    </fragment>

    <!-- GERIR PRODUTO -->
    <fragment
        android:id="@+id/gerirProdutoFragment"
        android:name="pt.ipleiria.estg.dei.amsi.homepantry.GerirProdutoFragment"
        android:label="Gerir Produto" />

    <!-- LISTA COMPRAS -->
    <fragment
        android:id="@+id/ListaComprasFragment"
        android:name="pt.ipleiria.estg.dei.amsi.homepantry.ListaComprasFragment"
        android:label="Listas de compras" />

    <!-- LISTA CATEGORIAS -->
    <fragment
        android:id="@+id/ListaCategoriasFragment"
        android:name="pt.ipleiria.estg.dei.amsi.homepantry.ListaCategoriasFragment"
        android:label="Categorias">

        <action
            android:id="@+id/action_listaCategorias_to_criarNovaCategoria"
            app:destination="@id/CriarNovaCategoriaFragment" />
    </fragment>

    <!-- CRIAR CATEGORIA -->
    <fragment
        android:id="@+id/CriarNovaCategoriaFragment"
        android:name="pt.ipleiria.estg.dei.amsi.homepantry.CriarNovaCategoriaFragment"
        android:label="Criar nova categoria" />

    <!-- CRIAR LOCAL -->
    <fragment
        android:id="@+id/CriarNovoLocalFragment"
        android:name="pt.ipleiria.estg.dei.amsi.homepantry.CriarNovoLocalFragment"
        android:label="Criar novo local" />

    <!-- CRIAR UTILIZADOR -->
    <fragment
        android:id="@+id/CriarNovoUtilizadorFragment"
        android:name="pt.ipleiria.estg.dei.amsi.homepantry.CriarNovoUtilizadorFragment"
        android:label="Criar novo utilizador" />

    <!-- CRIAR PRODUTO -->
    <fragment
        android:id="@+id/CriarNovoProdutoFragment"
        android:name="pt.ipleiria.estg.dei.amsi.homepantry.CriarNovoProdutoFragment"
        android:label="Criar novo produto" />

</navigation>
